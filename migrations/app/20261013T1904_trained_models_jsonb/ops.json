        "sql": "CREATE TABLE \"public\".\"TrainedModels\" (\n  \"activeKey\" text,\n  \"artifact\" jsonb NOT NULL,\n  \"createdAt\" timestamptz NOT NULL,\n  \"id\" character(36) NOT NULL,\n  \"kind\" text NOT NULL,\n  \"modelId\" text NOT NULL,\n  \"trainingReport\" jsonb,\n  \"updatedAt\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"active_kind_13263b1f\" CHECK (\"activeKey\" IS NULL OR \"activeKey\" = \"kind\"),\n  CONSTRAINT \"artifact_identity_4b8c96e6\" CHECK (jsonb_typeof(\"artifact\") = 'object' AND (\"artifact\" #>> '{metadata,modelId}') IS NOT NULL AND \"modelId\" = \"artifact\" #>> '{metadata,modelId}'),\n  CONSTRAINT \"report_object_53868cbb\" CHECK (\"trainingReport\" IS NULL OR jsonb_typeof(\"trainingReport\") = 'object')\n)",
        "params": []
      }
    ],
