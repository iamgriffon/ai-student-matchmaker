{
  "name": "vestibulandos",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun run build:browser && prisma generate && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:generate": "prisma generate",
    "db:migrate:local": "wrangler d1 migrations apply vestibulandos --local",
    "db:migrate:remote": "wrangler d1 migrations apply vestibulandos --remote",
    "types": "wrangler types",
    "seed:local": "bun scripts/seed.ts --local",
    "seed:remote": "bun scripts/seed.ts --remote",
    "test": "bun test",
    "training:serve": "bun scripts/trainingServer.ts",
    "train:cloudflare": "bun scripts/trainExternal.ts",
    "build:cloudflare": "bun run build",
    "deploy:cloudflare": "bun run deploy",
    "build:browser": "bun scripts/buildBrowser.ts"
  },
  "dependencies": {
    "@prisma/adapter-d1": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tensorflow/tfjs": "4.22.0",
    "jose": "^6.2.12",
    "pg": "8.16.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261013.1",
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "wrangler": "4.150.0"
  },
  "packageManager": "bun@1.4.2"
}
