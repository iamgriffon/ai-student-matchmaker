{
  "name": "vestibulandos-score",
  "private": true,
  "packageManager": "bun@1.4.2",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "bun run scripts/cloudflare.ts build",
    "composer:deploy": "prisma deploy module.ts",
    "composer:dev": "prisma dev module.ts",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "deploy": "bun run scripts/cloudflare.ts deploy",
    "dev": "bun run scripts/cloudflare.ts dev",
    "dev:composer": "bun run build:node && bun run composer:dev",
    "migrate": "prisma db migrate",
    "migration:plan": "prisma migration plan",
    "migration:show": "prisma migration show",
    "migration:status": "prisma migration status",
    "start": "NODE_ENV=production bun run dist/server.mjs",
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "train:matchmaking": "bun run scripts/trainMatchmaking.ts",
    "train:matchmaking:compare": "bun run scripts/trainMatchmaking.ts --compare-learning-rates",
    "import:trained-models": "bun run scripts/importTrainedModels.ts",
    "dev:cloudflare": "bun run dev",
    "build:cloudflare": "bun run build",
    "deploy:cloudflare": "bun run deploy",
    "cloudflare:generate": "bun run --cwd cloudflare db:generate",
    "cloudflare:types": "bun run --cwd cloudflare types",
    "cloudflare:migrate:local": "bun run --cwd cloudflare db:migrate:local",
    "cloudflare:migrate:remote": "bun run --cwd cloudflare db:migrate:remote",
    "build:node": "tsdown",
    "deploy:node": "bun run build:node && bun run composer:deploy",
    "dev:node": "bun --watch scripts/dev.ts",
    "train:cloudflare": "bun run cloudflare/scripts/trainExternal.ts",
    "training:serve": "bun run cloudflare/scripts/trainingServer.ts"
  },
  "dependencies": {
    "@prisma/composer": "0.28.0",
    "@prisma/composer-prisma-cloud": "0.28.0",
    "@prisma/orm-extension-pgvector": "8.0.0-rc.16",
    "@prisma/orm-postgres": "8.0.0-rc.16",
    "@tensorflow/tfjs": "^4.22.0",
    "alchemy": "2.0.0-beta.78",
    "dotenv": "^18.0.6",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@prisma/dev": "0.25.2",
    "@types/node": "^26.6.4",
    "prisma": "8.0.0-rc.21",
    "tsdown": "^0.23.0",
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest"
  },
  "overrides": {
    "effect": "4.0.0-rc.115",
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "@effect/platform-node-shared": "4.0.0-rc.115",
    "@effect/sql-d1": "4.0.0-rc.115",
    "@effect/sql-sqlite-do": "4.0.0-rc.115",
    "@effect/vitest": "4.0.0-rc.115"
  }
}
