{
  "name": "vestibulandos-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "prisma generate && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:generate": "prisma generate",
    "db:migrate:local": "wrangler d1 migrations apply vestibulandos --local",
    "db:migrate:remote": "wrangler d1 migrations apply vestibulandos --remote",
    "types": "wrangler types",
    "seed:local": "bun scripts/seed.ts --local",
    "seed:remote": "bun scripts/seed.ts --remote"
  },
  "dependencies": {
    "@prisma/adapter-d1": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tensorflow/tfjs": "4.22.0",
    "jose": "^6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "wrangler": "4.150.0",
    "@cloudflare/workers-types": "5.20261013.1",
    "@types/bun": "latest"
  }
}
