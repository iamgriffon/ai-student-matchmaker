    },
    "precheck": [
      {
        "description": "ensure constraint \"Users_email_key\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "Users_email_key",
          "public",
          "\"public\".\"Users\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add unique constraint \"Users_email_key\"",
        "sql": "ALTER TABLE \"public\".\"Users\" ADD CONSTRAINT \"Users_email_key\" UNIQUE (\"email\")"
      }
    ],
    "postcheck": [
